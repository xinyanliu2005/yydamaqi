rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* 这个游戏没有账号系统——房间号本身就是访问凭证（跟原来 Claude db 能力的
       信任模型一样：知道/猜到房间号就能读写那个房间）。所以这里只能做到"只允许
       读写 games/{code} 这一个集合"，集合内部无法再按"是不是这个房间的玩家"细分
       权限。别把敏感信息塞进房间数据里。

       注意：Firebase 控制台新建数据库时默认给的"测试模式"规则会在30天后自动
       过期变成拒绝所有读写——部署前记得把这份规则贴到 Firebase 控制台的
       Firestore → 规则 页面里，替换掉默认的测试模式规则。 */
    match /games/{code} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
